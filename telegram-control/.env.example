# ===== Telegram Control for Claude Code — конфигурация =====
# Скопируй этот файл в .env и заполни значения.
# НИКОГДА не коммить .env с реальным токеном в git!

# --- ОБЯЗАТЕЛЬНЫЕ ---

# Токен бота от @BotFather (Telegram)
TELEGRAM_BOT_TOKEN=сюда_токен_от_BotFather

# Username твоего бота (без @), например: my_claude_bot
TELEGRAM_BOT_USERNAME=имя_твоего_бота

# Базовая папка, к которой бот даёт доступ Claude (твои проекты).
# В WSL домашние папки Windows доступны как /mnt/c/...
# Пример: /mnt/c/Users/ТВОЙ_ЮЗЕР/projects
APPROVED_DIRECTORY=/mnt/c/Users/USER/projects

# Твой Telegram user_id (узнать у @userinfobot). Только эти ID смогут управлять ботом!
# Несколько — через запятую: 11111111,22222222
ALLOWED_USERS=сюда_твой_user_id

# --- АУТЕНТИФИКАЦИЯ (выбери ОДИН вариант) ---

# Вариант 1 (по умолчанию, SDK): ключ Anthropic API
# ANTHROPIC_API_KEY=sk-ant-...

# Вариант 2 (подписка Claude): оставь ключ выше пустым и сделай `claude auth login` —
# тогда бот пойдёт через CLI с твоей подпиской.

# --- ОПЦИОНАЛЬНЫЕ (безопасность и лимиты) ---

CLAUDE_MAX_COST_PER_USER=10.0     # лимит трат на пользователя, USD (если через API-ключ)
CLAUDE_TIMEOUT_SECONDS=600        # таймаут операции (увеличен под рендер/парсинг)
AGENTIC_MODE=true                 # естественный язык вместо команд терминала
VERBOSE_LEVEL=1                   # 0=тихо, 1=обычно, 2=подробно
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
